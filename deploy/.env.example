# Copy to .env (same directory as docker-compose.yml) and edit.

# Postgres credentials (the db is internal to the compose network).
POSTGRES_USER=vellune
POSTGRES_DB=vellune
# Required. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Required. >= 32 chars. Generate: openssl rand -hex 32
# Do not change after first start.
VELLUNE_SECRET=

# Required. EXACT public origin users type in the browser, no trailing slash or path.
# Production: https://notes.example.com  (https enables Secure cookies).
# Used for OAuth redirects, cookies and the WebSocket Origin check; a mismatch breaks sync.
APP_URL=https://notes.example.com

# Host port published by the vellune container (default 8080).
# VELLUNE_PORT=8080

# RUST_LOG=info
