{
  "name": "@vellune/desktop",
  "productName": "Vellune",
  "desktopName": "vellune.desktop",
  "version": "0.0.1-alpha.1",
  "private": true,
  "description": "Vellune desktop app",
  "author": "Vellune Team",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron . --no-sandbox",
    "dev:prod": "electron . --no-sandbox",
    "test": "node --test tests/*.test.js",
    "build": "pnpm run build:prod",
    "build:prod": "electron-builder --linux --config electron-builder.prod.json",
    "build:dev": "electron-builder --linux --config electron-builder.dev.json"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
