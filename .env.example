# Database (PostgreSQL)
POSTGRES_USER=vellune
POSTGRES_PASSWORD=vellunepassword
POSTGRES_DB=vellune_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://vellune:vellunepassword@localhost:5432/vellune_dev

# Cache & Ephemeral State (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend API Service
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
RUST_LOG=info,vellune=debug

# Auth & sync (vellune-api)
# Secret for server-side derivations (fake prelogin salts). >= 32 chars; generate with: openssl rand -hex 32
VELLUNE_SECRET=change-me-to-a-long-random-string-0123456789
# Public URL of the web app; used for OAuth redirect URIs, cookie Secure flag, WebSocket Origin check.
# The admin panel can override it (Server settings).
APP_URL=http://localhost:3000
# Optional: serve the built web app from the API (e.g. apps/web/dist) for single-origin production.
# WEB_DIST=apps/web/dist
# Encrypted image blob store (ciphertext files, one directory per page).
BLOB_DIR=data/blobs

# Web Client
VITE_API_URL=http://localhost:8080
